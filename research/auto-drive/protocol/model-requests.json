{
  "schemaVersion": 1,
  "protocol": "auto-drive-swe-evo-v1.7",
  "worker": {
    "models": ["d-robotics/qwen3.8-max", "d-robotics/deepseek-v4-pro", "d-robotics/glm-5.3"],
    "temperature": 0,
    "reasoningEffort": "low",
    "maxOutputTokens": 32000,
    "segmentSteps": 6,
    "maxContinuations": 5,
    "timeoutSeconds": 2700,
    "toolChoice": "auto",
    "transport": "openai-responses",
    "responseAccounting": "raw-response-sha256-and-complete-usage-required",
    "failureAccounting": "five-second-idle-boundary-with-observed-token-lower-bound",
    "providerVersion": null,
    "resolvedRequestSHA256": null,
    "resolutionRule": "Executor must save the exact provider model version and normalized outbound request SHA-256 in every trajectory. Null is invalid for a completed trajectory."
  },
  "supervisor": {
    "model": "d-robotics/qwen3.8-max",
    "temperature": 0,
    "maxOutputTokens": 1024,
    "tools": [],
    "transport": "openai-chat-completions",
    "responseAccounting": "raw-response-sha256-and-complete-usage-required",
    "timeoutSeconds": 15,
    "fallback": "regex",
    "providerVersion": null,
    "resolvedRequestSHA256": null,
    "resolutionRule": "Resolved fields remain null before paid execution and are mandatory in accepted trajectory records."
  },
  "continuation": {
    "delivery": "queue",
    "staticPrompt": "Please proceed with the next step.",
    "offPolicy": "first-boundary-prefix"
  }
}
