                "dvc.lock",
                "copy.py",
                "params.yaml",
                "metrics.yaml",
                "data.dvc",
                ".gitignore",
            ]
        )
        scm.commit("init")
    
        tmp_dir.gen("params.yaml", params)
        tmp_dir.gen("data", "modified")
    
