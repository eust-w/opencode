            erepo_dir.scm_add(
                [erepo_dir.dvc.config.files["repo"]],
                "set source repo cache type to symlink",
            )
            erepo_dir.dvc_gen("foo", "foo content", "create foo")
        assert system.is_symlink(erepo_dir / "foo")
    
