    def test_plot_cache_missing(tmp_dir, scm, dvc, caplog, run_copy_metrics):
        metric1 = [{"y": 2}, {"y": 3}]
        (tmp_dir / "metric_t.json").dump_json(metric1, sort_keys=True)
