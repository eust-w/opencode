    def test_modified_subrepo(tmp_dir, scm, dvc):
        from dvc.repo import Repo
    
        tmp_dir.gen({"subdir": {"file": "first"}})
        subrepo_dir = tmp_dir / "subdir"
    
        with subrepo_dir.chdir():
